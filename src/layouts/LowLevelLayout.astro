---
import { splitTopic, termHref } from '../lib/terms'
import BaseLayout from './BaseLayout.astro'
import { chapterById } from '../lib/curriculum'
import { loadLowLevelNotes } from '../lib/prereq'
import type { CollectionEntry } from 'astro:content'

type Props = {
  entry: CollectionEntry<'lowlevel'>
  prev?: { id: string; title: string }
  next?: { id: string; title: string }
  headings: { depth: number; slug: string; text: string }[]
}
const { entry, prev, next, headings } = Astro.props
const d = entry.data
const base = import.meta.env.BASE_URL
const toc = headings.filter((h) => h.depth === 2)
const chapter = chapterById.get(d.chapter)

const { buildById } = await loadLowLevelNotes()
const handsOn = d.handsOn.map((h) => {
  const step = buildById.get(h.slug)!
  return { ...h, title: step.data.title, published: step.data.status === 'published' }
})
---

<BaseLayout title={`${d.title} | 低レイヤ | Pattern Lab`} description={d.description} area="lowlevel">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="prose min-w-0">
      <p class="not-prose m-0 flex flex-wrap items-center gap-2 text-xs font-bold">
        <a href={`${base}lowlevel/`} class="no-underline" style="color: var(--accent)">低レイヤ</a>
        <span style="color: var(--fg-muted)">{chapter?.title ?? d.chapter}</span>
      </p>
      <h1 class="mt-1 mb-2 text-3xl font-bold leading-snug">{d.title}</h1>
      <p class="mt-0 text-[15px]" style="color: var(--fg-muted)">{d.description}</p>

      {
        d.topics.length > 0 && (
          <ul class="not-prose m-0 mt-4 flex list-none flex-wrap gap-1.5 p-0">
            {d.topics.flatMap(splitTopic).map((t) => (
              <li>
                <a
                  href={termHref(base, t)}
                  class="block rounded px-2 py-0.5 font-mono text-[11px] no-underline hover:border-[var(--accent)]"
                  style="background: var(--bg-soft); color: var(--fg-muted); border: 1px solid var(--border)"
                >
                  {t}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <slot />

      {
        handsOn.length > 0 && (
          <section class="not-prose my-10 rounded-xl border" style="border-color: var(--ok)">
            <h3
              class="m-0 border-b px-4 py-3 text-sm font-bold"
              style="border-color: var(--ok); background: var(--ok-soft); color: var(--ok)"
            >
              この話を、実際に手で作る
            </h3>
            <ul class="m-0 list-none p-0">
              {handsOn.map((h) => (
                <li class="border-b px-4 py-2.5 last:border-b-0" style="border-color: var(--border)">
                  {h.published ? (
                    <a
                      href={`${base}build/${h.slug}/`}
                      class="text-sm font-bold no-underline hover:underline"
                      style="color: var(--accent)"
                    >
                      {h.title}
                    </a>
                  ) : (
                    <span class="text-sm font-bold" style="color: var(--fg-muted)">
                      {h.title}
                      <span class="ml-2 text-[10px]">（準備中）</span>
                    </span>
                  )}
                  <p class="m-0 mt-1 text-xs leading-relaxed" style="color: var(--fg-muted)">{h.why}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <nav
        class="not-prose mt-16 flex flex-wrap gap-3 border-t pt-6 text-sm"
        style="border-color: var(--border)"
      >
        {
          prev && (
            <a
              href={`${base}lowlevel/${prev.id}/`}
              class="flex-1 rounded-lg border px-4 py-3 no-underline"
              style="border-color: var(--border); color: var(--fg)"
            >
              <span class="block text-xs" style="color: var(--fg-muted)">← 前</span>
              {prev.title}
            </a>
          )
        }
        {
          next && (
            <a
              href={`${base}lowlevel/${next.id}/`}
              class="flex-1 rounded-lg border px-4 py-3 text-right no-underline"
              style="border-color: var(--border); color: var(--fg)"
            >
              <span class="block text-xs" style="color: var(--fg-muted)">次 →</span>
              {next.title}
            </a>
          )
        }
      </nav>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20 text-sm">
        <p class="mb-2 text-xs font-bold" style="color: var(--fg-muted)">目次</p>
        <ul class="m-0 list-none space-y-1.5 border-l p-0 pl-3" style="border-color: var(--border)">
          {
            toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="no-underline" style="color: var(--fg-muted)">{h.text}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
