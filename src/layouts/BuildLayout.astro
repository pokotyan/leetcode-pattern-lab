---
import BaseLayout from './BaseLayout.astro'
import { trackById } from '../lib/curriculum'
import { loadBuildSteps } from '../lib/prereq'
import type { CollectionEntry } from 'astro:content'

type Props = {
  entry: CollectionEntry<'build'>
  prev?: { id: string; title: string }
  next?: { id: string; title: string }
  headings: { depth: number; slug: string; text: string }[]
}
const { entry, prev, next, headings } = Astro.props
const d = entry.data
const base = import.meta.env.BASE_URL
const toc = headings.filter((h) => h.depth === 2)
const track = trackById.get(d.track)

const { requires, articleById, mathById, readingById } = await loadBuildSteps()
const prereqs = requires.get(entry.id) ?? []
const foundations = d.basedOn.map((b) => {
  const pool = b.kind === 'article' ? articleById : b.kind === 'math' ? mathById : readingById
  const dir = b.kind === 'article' ? 'articles' : b.kind === 'math' ? 'math' : 'reading'
  return { ...b, title: pool.get(b.slug)!.data.title, href: `${base}${dir}/${b.slug}/` }
})
const KIND_LABEL = { article: '型', math: '数学', reading: '読み物' }
---

<BaseLayout title={`${d.title} | 作る | Pattern Lab`} description={d.description} area="build">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="prose min-w-0">
      <p class="not-prose m-0 flex flex-wrap items-center gap-2 text-xs font-bold">
        <a href={`${base}build/`} class="no-underline" style="color: var(--accent)">作る</a>
        <span style="color: var(--fg-muted)">{track?.title ?? d.track}</span>
        <span class="font-mono" style="color: var(--fg-muted)">第 {d.order} 回</span>
      </p>
      <h1 class="mt-1 mb-2 text-3xl font-bold leading-snug">{d.title}</h1>
      <p class="mt-0 text-[15px]" style="color: var(--fg-muted)">{d.description}</p>

      <section class="not-prose my-6 rounded-xl border px-4 py-3" style="border-color: var(--ok); background: var(--ok-soft)">
        <p class="m-0 text-xs font-bold" style="color: var(--ok)">この回を終えると動くもの</p>
        <p class="m-0 mt-1 text-sm leading-relaxed" style="color: var(--fg)">{d.goal}</p>
      </section>

      {
        prereqs.length > 0 && (
          <section class="not-prose my-6 rounded-xl border px-4 py-3" style="border-color: var(--border); background: var(--bg-soft)">
            <p class="m-0 text-xs font-bold" style="color: var(--fg-muted)">先にやっておく回</p>
            <ul class="m-0 mt-2 list-none space-y-1 p-0">
              {prereqs.map((p) => (
                <li>
                  <a href={`${base}build/${p.id}/`} class="text-sm font-bold no-underline hover:underline" style="color: var(--accent)">
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        foundations.length > 0 && (
          <section class="not-prose my-8 rounded-xl border" style="border-color: var(--accent)">
            <h3
              class="m-0 border-b px-4 py-3 text-sm font-bold"
              style="border-color: var(--accent); background: var(--accent-soft); color: var(--accent)"
            >
              ここで効いてくる、本編の知識
            </h3>
            <ul class="m-0 list-none p-0">
              {foundations.map((f) => (
                <li class="border-b px-4 py-2.5 last:border-b-0" style="border-color: var(--border)">
                  <a href={f.href} class="text-sm font-bold no-underline hover:underline" style="color: var(--accent)">
                    {f.title}
                  </a>
                  <span
                    class="ml-2 rounded px-1.5 py-0.5 text-[10px]"
                    style={
                      f.kind === 'math'
                        ? 'color: var(--ok); background: var(--ok-soft)'
                        : 'color: var(--warn); background: var(--warn-soft)'
                    }
                  >
                    {KIND_LABEL[f.kind]}
                  </span>
                  <p class="m-0 mt-1 text-xs leading-relaxed" style="color: var(--fg-muted)">{f.why}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <slot />

      <nav
        class="not-prose mt-16 flex flex-wrap gap-3 border-t pt-6 text-sm"
        style="border-color: var(--border)"
      >
        {
          prev && (
            <a
              href={`${base}build/${prev.id}/`}
              class="flex-1 rounded-lg border px-4 py-3 no-underline"
              style="border-color: var(--border); color: var(--fg)"
            >
              <span class="block text-xs" style="color: var(--fg-muted)">← 前</span>
              {prev.title}
            </a>
          )
        }
        {
          next && (
            <a
              href={`${base}build/${next.id}/`}
              class="flex-1 rounded-lg border px-4 py-3 text-right no-underline"
              style="border-color: var(--border); color: var(--fg)"
            >
              <span class="block text-xs" style="color: var(--fg-muted)">次 →</span>
              {next.title}
            </a>
          )
        }
      </nav>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20 text-sm">
        <p class="mb-2 text-xs font-bold" style="color: var(--fg-muted)">目次</p>
        <ul class="m-0 list-none space-y-1.5 border-l p-0 pl-3" style="border-color: var(--border)">
          {
            toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="no-underline" style="color: var(--fg-muted)">{h.text}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
