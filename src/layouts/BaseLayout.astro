---
import '../styles/global.css'
import { AREAS, SITE_NAME, SITE_TAGLINE, areaById } from '../lib/nav'

type Props = {
  title: string
  description?: string
  /** 今いる区画。ヘッダーの強調とサブナビに使う */
  area?: string
}
const { title, description = SITE_TAGLINE, area } = Astro.props
const base = import.meta.env.BASE_URL
const current = area ? areaById.get(area) : undefined
const subItems = current?.items ?? []
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧭</text></svg>"
    />
    <script is:inline>
      const saved = localStorage.getItem('theme')
      if (saved) document.documentElement.dataset.theme = saved
    </script>
  </head>
  <body>
    <header
      class="sticky top-0 z-20 border-b backdrop-blur"
      style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 88%, transparent)"
    >
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a href={base} class="font-bold tracking-tight no-underline" style="color: var(--fg)">
          <span style="color: var(--accent)">▲</span> {SITE_NAME}
        </a>
        <nav class="ml-auto flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          {
            AREAS.map((a) => (
              <a
                href={`${base}${a.path}`}
                class={a.id === area ? 'font-bold' : ''}
                style={a.id === area ? 'color: var(--accent)' : 'color: var(--fg-muted)'}
              >
                {a.title}
              </a>
            ))
          }
          <button
            id="theme-toggle"
            class="rounded border px-2 py-1 text-xs"
            style="border-color: var(--border); color: var(--fg-muted)"
            aria-label="配色を切り替える">◑</button
          >
        </nav>
      </div>

      {
        subItems.length > 0 && (
          <div class="border-t" style="border-color: var(--border)">
            <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2 text-xs">
              <a
                href={`${base}${current!.path}`}
                class="font-bold no-underline"
                style="color: var(--fg)"
              >
                {current!.title}
              </a>
              {subItems.map((item) => (
                <a href={`${base}${item.path}`} style="color: var(--fg-muted)">
                  {item.title}
                </a>
              ))}
            </nav>
          </div>
        )
      }
    </header>

    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>

    <footer
      class="mt-16 border-t px-4 py-8 text-center text-xs"
      style="border-color: var(--border); color: var(--fg-muted)"
    >
      {SITE_NAME} — {SITE_TAGLINE}
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement
        const now =
          el.dataset.theme ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        const next = now === 'dark' ? 'light' : 'dark'
        el.dataset.theme = next
        localStorage.setItem('theme', next)
      })
    </script>
  </body>
</html>
