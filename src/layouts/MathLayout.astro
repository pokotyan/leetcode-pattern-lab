---
import BaseLayout from './BaseLayout.astro'
import ProblemTable from '../components/ProblemTable.astro'
import { buildMathGraph } from '../lib/prereq'
import type { CollectionEntry } from 'astro:content'

type Props = {
  entry: CollectionEntry<'math'>
  prev?: { id: string; title: string }
  next?: { id: string; title: string }
  headings: { depth: number; slug: string; text: string }[]
}
const { entry, prev, next, headings } = Astro.props
const d = entry.data
const base = import.meta.env.BASE_URL
const toc = headings.filter((h) => h.depth === 2)

const { requires, articleById } = await buildMathGraph()
const prereqs = requires.get(entry.id) ?? []
const uses = d.usedIn.map((u) => ({ ...u, article: articleById.get(u.slug)! }))
---

<BaseLayout title={`${d.title} | 数学の副読本 | LeetCode Pattern Lab`} description={d.description}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="prose min-w-0">
      <p class="not-prose m-0 flex items-center gap-2 text-xs font-bold">
        <a href={`${base}math/`} class="no-underline" style="color: var(--accent)">数学の副読本</a>
        <span class="rounded px-1.5 py-0.5" style="color: var(--ok); background: var(--ok-soft)">
          副読本
        </span>
      </p>
      <h1 class="mt-1 mb-2 text-3xl font-bold leading-snug">{d.title}</h1>
      <p class="mt-0 text-[15px]" style="color: var(--fg-muted)">{d.description}</p>

      {
        prereqs.length > 0 && (
          <section class="not-prose my-8 rounded-xl border" style="border-color: var(--accent)">
            <h3
              class="m-0 border-b px-4 py-3 text-sm font-bold"
              style="border-color: var(--accent); background: var(--accent-soft); color: var(--accent)"
            >
              このノートの前に読む
            </h3>
            <ul class="m-0 list-none p-0">
              {prereqs.map((r) => (
                <li class="border-b px-4 py-2.5 last:border-b-0" style="border-color: var(--border)">
                  <a
                    href={`${base}math/${r.id}/`}
                    class="text-sm font-bold no-underline hover:underline"
                    style="color: var(--accent)"
                  >
                    {r.data.title}
                  </a>
                  <p class="m-0 mt-1 text-xs leading-relaxed" style="color: var(--fg-muted)">
                    {r.data.description}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        uses.length > 0 && (
          <section class="not-prose my-8 rounded-xl border" style="border-color: var(--ok)">
            <h3
              class="m-0 border-b px-4 py-3 text-sm font-bold"
              style="border-color: var(--ok); background: var(--ok-soft); color: var(--ok)"
            >
              この知識を使う型（逆引き）
            </h3>
            <ul class="m-0 list-none p-0">
              {uses.map((u) => (
                <li class="border-b px-4 py-2.5 last:border-b-0" style="border-color: var(--border)">
                  <a
                    href={`${base}articles/${u.slug}/`}
                    class="text-sm font-bold no-underline hover:underline"
                    style="color: var(--accent)"
                  >
                    {u.article.data.title}
                  </a>
                  <p class="m-0 mt-1 text-xs leading-relaxed" style="color: var(--fg-muted)">
                    {u.why}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <ProblemTable problems={d.problems} title="この知識が要る LeetCode 問題" />

      <slot />

      <nav
        class="not-prose mt-16 flex flex-wrap gap-3 border-t pt-6 text-sm"
        style="border-color: var(--border)"
      >
        {
          prev && (
            <a
              href={`${base}math/${prev.id}/`}
              class="flex-1 rounded-lg border px-4 py-3 no-underline"
              style="border-color: var(--border); color: var(--fg)"
            >
              <span class="block text-xs" style="color: var(--fg-muted)">
                ← 前
              </span>
              {prev.title}
            </a>
          )
        }
        {
          next && (
            <a
              href={`${base}math/${next.id}/`}
              class="flex-1 rounded-lg border px-4 py-3 text-right no-underline"
              style="border-color: var(--border); color: var(--fg)"
            >
              <span class="block text-xs" style="color: var(--fg-muted)">
                次 →
              </span>
              {next.title}
            </a>
          )
        }
      </nav>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20 text-sm">
        <p class="mb-2 text-xs font-bold" style="color: var(--fg-muted)">目次</p>
        <ul class="m-0 list-none space-y-1.5 border-l p-0 pl-3" style="border-color: var(--border)">
          {
            toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="no-underline" style="color: var(--fg-muted)">
                  {h.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
