---
import { splitTopic } from '../../lib/terms'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { READING_SECTIONS } from '../../lib/curriculum'
import { buildReadingGraph, orderArticles } from '../../lib/prereq'

const base = import.meta.env.BASE_URL
const { notes, byArticle, byMath, articleById, mathById } = await buildReadingGraph()

const byCategory = READING_SECTIONS.map((s) => ({
  section: s,
  items: notes.filter((n) => n.data.category === s.id),
})).filter((g) => g.items.length > 0)

const topicCount = new Set(notes.flatMap((n) => n.data.topics.flatMap(splitTopic))).size

// 型から引く向き
const fromArticles = orderArticles([...articleById.values()])
  .filter((a) => (byArticle.get(a.id) ?? []).length > 0)
  .map((a) => ({ title: a.data.title, href: `${base}articles/${a.id}/`, uses: byArticle.get(a.id)! }))
const fromMath = [...mathById.values()]
  .sort((a, b) => a.data.order - b.data.order)
  .filter((m) => (byMath.get(m.id) ?? []).length > 0)
  .map((m) => ({ title: m.data.title, href: `${base}math/${m.id}/`, uses: byMath.get(m.id)! }))
---

<BaseLayout
  title="仕組みを読む | システム設計 | Pattern Lab"
  description="検索・分散システム・データ基盤で出てくる仕組みを、本編で扱った型と結びつけて読む"
 area="system-design">
  <section class="mb-12">
    <h1 class="mb-3 text-3xl font-bold leading-snug">仕組みを読む</h1>
    <p class="max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      検索エンジン、分散システム、データベースの索引、メッセージング。
      実務で名前だけは聞く仕組みを、<strong style="color: var(--fg)">中で何が起きているか</strong>まで降りて読む。
    </p>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      ここに出てくる仕組みの多くは、<a href={`${base}algorithms/`} style="color: var(--accent)">アルゴリズム</a
      >で扱った型の組み合わせでできている。
      各記事の冒頭に<strong style="color: var(--fg)">「この仕組みの土台になっている型」</strong>を置いてあるので、
      知らない土台に当たったらそちらへ戻れる。逆に、型の側から
      「この型は実務のどこで効くのか」を引くこともできる。
    </p>
    <dl class="mt-6 flex flex-wrap gap-8 text-sm">
      <div>
        <dt style="color: var(--fg-muted)">記事</dt>
        <dd class="m-0 text-2xl font-bold">{notes.length}</dd>
      </div>
      <div>
        <dt style="color: var(--fg-muted)">扱う用語</dt>
        <dd class="m-0 text-2xl font-bold">
          <a href={`${base}terms/`} class="no-underline" style="color: var(--accent)">{topicCount}</a>
        </dd>
      </div>
      <div>
        <dt style="color: var(--fg-muted)">つながる型</dt>
        <dd class="m-0 text-2xl font-bold">{fromArticles.length + fromMath.length}</dd>
      </div>
    </dl>
  </section>

  <div class="mb-16 space-y-10">
    {
      byCategory.map((g) => (
        <section>
          <h2 class="mb-1 text-lg font-bold">{g.section.title}</h2>
          <p class="mb-3 text-sm" style="color: var(--fg-muted)">
            {g.section.summary}
          </p>
          <ul class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2">
            {g.items.map((n) => (
              <li>
                <a
                  href={`${base}reading/${n.id}/`}
                  class="flex h-full flex-col rounded-xl border px-4 py-3 no-underline transition-colors hover:border-[var(--accent)]"
                  style="border-color: var(--border); background: var(--bg-soft); color: var(--fg)"
                >
                  <span class="font-bold">{n.data.title}</span>
                  <span class="mt-1 text-xs leading-relaxed" style="color: var(--fg-muted)">
                    {n.data.description}
                  </span>
                  {n.data.topics.length > 0 && (
                    <span class="mt-2 font-mono text-[11px]" style="color: var(--fg-muted)">
                      {n.data.topics.join(' / ')}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section>
    <h2 class="mb-1 text-xl font-bold">逆引き：この型は、実務のどこで効くのか</h2>
    <p class="mb-5 text-sm" style="color: var(--fg-muted)">
      アルゴリズムの型と数学ノートから、それが使われている記事を引く。
    </p>
    <div class="space-y-3">
      {
        [...fromArticles, ...fromMath].map((row) => (
          <div
            class="rounded-xl border px-4 py-3"
            style="border-color: var(--border); background: var(--bg-soft)"
          >
            <a
              href={row.href}
              class="text-sm font-bold no-underline hover:underline"
              style="color: var(--fg)"
            >
              {row.title}
            </a>
            <ul class="m-0 mt-2 list-none space-y-1.5 p-0">
              {row.uses.map((u) => (
                <li>
                  <a
                    href={`${base}reading/${u.note.id}/`}
                    class="text-xs font-bold no-underline hover:underline"
                    style="color: var(--accent)"
                  >
                    {u.note.data.title}
                  </a>
                  <span class="ml-2 text-xs" style="color: var(--fg-muted)">
                    {u.why}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
