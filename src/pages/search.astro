---
import BaseLayout from '../layouts/BaseLayout.astro'

const base = import.meta.env.BASE_URL
---

<BaseLayout title="検索 | Pattern Lab" description="低レイヤとシステム設計の記事を本文から検索する">
  <section class="mb-6">
    <h1 class="mb-3 text-3xl font-bold leading-snug">検索</h1>
    <p class="max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      <a href={`${base}lowlevel/`} style="color: var(--accent)">低レイヤ</a>と
      <a href={`${base}reading/`} style="color: var(--accent)">システム設計の読み物</a>の本文を検索します。
    </p>
  </section>

  <link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />
  <div id="search"></div>
  <script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>
  <script is:inline>
    new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false })
  </script>
</BaseLayout>

<style is:global>
  #search {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-soft);
    --pagefind-ui-font: inherit;
  }
</style>
