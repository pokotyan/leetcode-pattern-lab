---
import { splitTopic } from '../lib/terms'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { AREAS, SITE_TAGLINE } from '../lib/nav'
import { LOWLEVEL_CHAPTERS, BUILD_TRACKS } from '../lib/curriculum'

const base = import.meta.env.BASE_URL

const [articles, math, reading, lowlevel, build] = await Promise.all([
  getCollection('articles'),
  getCollection('math'),
  getCollection('reading'),
  getCollection('lowlevel'),
  getCollection('build'),
])

const pub = (xs: { data: { status: string } }[]) =>
  xs.filter((x) => x.data.status === 'published').length

/** 区画ごとに、カードへ出す数字 */
const STATS: Record<string, { label: string; value: number | string }[]> = {
  algorithms: [
    { label: '記事', value: pub(articles) + pub(math) },
    {
      label: '扱う LeetCode 問題',
      value: new Set(articles.flatMap((a) => a.data.problems.map((p) => p.url))).size,
    },
  ],
  'system-design': [
    { label: '記事', value: pub(reading) },
    { label: '扱う用語', value: new Set(reading.flatMap((r) => r.data.topics.flatMap(splitTopic))).size },
  ],
  lowlevel: [
    { label: '章', value: LOWLEVEL_CHAPTERS.length },
    { label: '記事', value: pub(lowlevel) },
    { label: '扱う用語', value: new Set(lowlevel.flatMap((n) => n.data.topics.flatMap(splitTopic))).size },
  ],
  build: [
    { label: 'トラック', value: BUILD_TRACKS.length },
    { label: '公開済みの回', value: pub(build) },
  ],
}
---

<BaseLayout title="Pattern Lab" description={SITE_TAGLINE}>
  <section class="mb-14">
    <h1 class="mb-4 text-3xl font-bold leading-snug sm:text-4xl">
      型・仕組み・実装を、<br class="sm:hidden" />繋ぎ直す
    </h1>
    <p class="max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      アルゴリズムの型、大きなシステムの仕組み、コンピュータの下のほうで起きていること、
      そしてそれらを実際に組み上げること。
      別々に学ぶと繋がらないものを、<strong style="color: var(--fg)">同じ 1 本の線の上に並べる</strong
      >ための学習ノートです。
    </p>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      どの区画からでも始められます。記事の中では、土台になっている別の区画の回へ
      いつでも戻れるようにリンクを張ってあります。
    </p>
  </section>

  <div class="mb-16 grid gap-4 sm:grid-cols-2">
    {
      AREAS.map((area, i) => (
        <a
          href={`${base}${area.path}`}
          class="flex flex-col rounded-xl border px-5 py-5 no-underline transition-colors hover:border-[var(--accent)]"
          style="border-color: var(--border); background: var(--bg-soft); color: var(--fg)"
        >
          <span class="font-mono text-xs" style="color: var(--fg-muted)">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="mt-1 text-xl font-bold">{area.title}</span>
          <span class="mt-1 text-sm font-bold" style="color: var(--accent)">
            {area.tagline}
          </span>
          <span class="mt-3 text-[13px] leading-relaxed" style="color: var(--fg-muted)">
            {area.summary}
          </span>

          <dl class="mt-4 flex flex-wrap gap-6 text-xs">
            {STATS[area.id]?.map((s) => (
              <div>
                <dt style="color: var(--fg-muted)">{s.label}</dt>
                <dd class="m-0 text-lg font-bold">{s.value}</dd>
              </div>
            ))}
          </dl>

          {area.items.length > 1 && (
            <span class="mt-3 font-mono text-[11px]" style="color: var(--fg-muted)">
              {area.items.map((it) => it.title).join(' / ')}
            </span>
          )}
        </a>
      ))
    }
  </div>

  <section class="mb-10">
    <h2 class="mb-1 text-xl font-bold">迷ったら</h2>
    <p class="mb-5 max-w-2xl text-sm leading-relaxed" style="color: var(--fg-muted)">
      目的別の入口です。
    </p>
    <div class="space-y-3">
      {
        [
          {
            q: 'コーディング面接の対策をしたい',
            a: 'アルゴリズム',
            href: 'algorithms/',
            why: '型ごとに解説とシミュレーター、対応する LeetCode 問題が並んでいます',
          },
          {
            q: 'システムデザイン面接の対策をしたい',
            a: 'システム設計',
            href: 'system-design/',
            why: '検索、分散合意、索引、メッセージングを、中身まで降りて読みます',
          },
          {
            q: '「なんとなく知っている」を説明できるようにしたい',
            a: '低レイヤ',
            href: 'lowlevel/',
            why: 'セグフォ、仮想メモリ、リンク、システムコール。16 章で上から順に',
          },
          {
            q: '読むだけでは身についた気がしない',
            a: '作る',
            href: 'build/',
            why: 'NAND から CPU を組み、言語を作り、エミュレータを書きます',
          },
        ].map((row) => (
          <a
            href={`${base}${row.href}`}
            class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-xl border px-4 py-3 no-underline"
            style="border-color: var(--border); background: var(--bg-soft); color: var(--fg)"
          >
            <span class="text-sm font-bold">{row.q}</span>
            <span class="text-sm font-bold" style="color: var(--accent)">
              → {row.a}
            </span>
            <span class="w-full text-xs" style="color: var(--fg-muted)">
              {row.why}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
