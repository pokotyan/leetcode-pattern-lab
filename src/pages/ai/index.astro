---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { AI_TRACKS } from '../../lib/curriculum'
import { loadAiNotes } from '../../lib/prereq'

const base = import.meta.env.BASE_URL
const { notes } = await loadAiNotes()

const byTrack = AI_TRACKS.map((track) => ({
  track,
  items: notes.filter((n) => n.data.track === track.id),
}))
const published = notes.filter((n) => n.data.status === 'published').length
---

<BaseLayout
  title="AI | Pattern Lab"
  description="ニューラルネットワークから Transformer、強化学習、拡散モデルまで。AI の根っこにある考え方と、それを支える数学を、動かしながら読む"
  area="ai"
>
  <section class="mb-12">
    <h1 class="mb-3 text-3xl font-bold leading-snug">AI</h1>
    <p class="max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      道具の使い方は数か月で入れ替わりますが、その下にある考え方は数十年かけて積み上がってきたものです。
      ここでは<strong style="color: var(--fg)">元になった論文の順に、何が新しかったのか</strong>をたどります。
    </p>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      理系の専門教育を前提にしません。ただし、式を避けて比喩だけで済ませることもしません。
      必要な数学は数学トラックにまとめ、スライダーを動かして形で掴めるようにしてあります。
    </p>
    <dl class="mt-6 flex flex-wrap gap-8 text-sm">
      <div>
        <dt style="color: var(--fg-muted)">トラック</dt>
        <dd class="m-0 text-2xl font-bold">{AI_TRACKS.length}</dd>
      </div>
      <div>
        <dt style="color: var(--fg-muted)">公開済みの回</dt>
        <dd class="m-0 text-2xl font-bold">{published}</dd>
      </div>
    </dl>
  </section>

  <div class="space-y-10">
    {
      byTrack.map(({ track, items }) => (
        <section>
          <h2 class="mb-1 text-lg font-bold">{track.title}</h2>
          <p class="mb-4 text-sm" style="color: var(--fg-muted)">{track.summary}</p>
          {items.length === 0 ? (
            <p class="m-0 rounded-xl border border-dashed px-4 py-6 text-center text-sm" style="border-color: var(--border); color: var(--fg-muted)">
              準備中
            </p>
          ) : (
            <ol class="m-0 list-none space-y-2 p-0">
              {items.map((n) => (
                <li>
                  <a
                    href={`${base}ai/${n.id}/`}
                    class="flex gap-3 rounded-xl border px-4 py-3 no-underline transition-colors hover:border-[var(--accent)]"
                    style="border-color: var(--border); background: var(--bg-soft); color: var(--fg)"
                  >
                    <span class="shrink-0 font-mono text-sm" style="color: var(--fg-muted)">
                      {String(n.data.order).padStart(2, '0')}
                    </span>
                    <span class="min-w-0">
                      <span class="block font-bold">{n.data.title}</span>
                      <span class="mt-1 block text-xs leading-relaxed" style="color: var(--fg-muted)">
                        {n.data.description}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>
