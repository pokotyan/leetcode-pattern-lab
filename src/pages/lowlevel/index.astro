---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { LOWLEVEL_CHAPTERS } from '../../lib/curriculum'
import { loadLowLevelNotes } from '../../lib/prereq'

const base = import.meta.env.BASE_URL
const { notes } = await loadLowLevelNotes()

const byChapter = LOWLEVEL_CHAPTERS.map((chapter) => ({
  chapter,
  items: notes.filter((n) => n.data.chapter === chapter.id),
})).filter((g) => g.items.length > 0)

const published = notes.filter((n) => n.data.status === 'published').length
const topicCount = new Set(notes.flatMap((n) => n.data.topics)).size
---

<BaseLayout
  title="低レイヤ | LeetCode Pattern Lab"
  description="CPU、メモリ、プロセス、仮想メモリ、リンク。コンピュータの下のほうで何が起きているかを、上から順に読む"
>
  <section class="mb-12">
    <h1 class="mb-3 text-3xl font-bold leading-snug">低レイヤ</h1>
    <p class="max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      プロセスとスレッドの違い、セグメンテーションフォールトが起きる理由、リンクエラーの読み方。
      名前は知っているのに、聞かれると答えに詰まるもの。それを
      <strong style="color: var(--fg)">上から順に 1 本の線でつなぎ直す</strong>ための読み物です。
    </p>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed" style="color: var(--fg-muted)">
      章の順番がそのまま読む順番です。後ろの章は前の章の用語を説明なしに使います。
      そして、ここで読んだ話の多くは
      <a href={`${base}build/`} style="color: var(--accent)">作る</a>
      で実際に自分の手で組むことになります。各回の最後に、その橋渡しを置いてあります。
    </p>
    <dl class="mt-6 flex flex-wrap gap-8 text-sm">
      <div>
        <dt style="color: var(--fg-muted)">章</dt>
        <dd class="m-0 text-2xl font-bold">{LOWLEVEL_CHAPTERS.length}</dd>
      </div>
      <div>
        <dt style="color: var(--fg-muted)">公開済み</dt>
        <dd class="m-0 text-2xl font-bold">{published}</dd>
      </div>
      <div>
        <dt style="color: var(--fg-muted)">扱う用語</dt>
        <dd class="m-0 text-2xl font-bold">{topicCount}</dd>
      </div>
    </dl>
  </section>

  <div class="space-y-10">
    {
      byChapter.map(({ chapter, items }) => (
        <section>
          <h2 class="mb-1 text-lg font-bold">{chapter.title}</h2>
          <p class="mb-4 text-sm" style="color: var(--fg-muted)">{chapter.summary}</p>
          <ol class="m-0 list-none space-y-2 p-0">
            {items.map((n) => (
              <li>
                {n.data.status === 'published' ? (
                  <a
                    href={`${base}lowlevel/${n.id}/`}
                    class="block rounded-xl border px-4 py-3 no-underline transition-colors hover:border-[var(--accent)]"
                    style="border-color: var(--border); background: var(--bg-soft); color: var(--fg)"
                  >
                    <span class="block font-bold">{n.data.title}</span>
                    <span class="mt-1 block text-xs leading-relaxed" style="color: var(--fg-muted)">
                      {n.data.description}
                    </span>
                    {n.data.topics.length > 0 && (
                      <span class="mt-2 block font-mono text-[11px]" style="color: var(--fg-muted)">
                        {n.data.topics.join(' / ')}
                      </span>
                    )}
                  </a>
                ) : (
                  <div
                    class="block rounded-xl border border-dashed px-4 py-3"
                    style="border-color: var(--border); color: var(--fg-muted)"
                  >
                    <span class="block font-bold">{n.data.title}</span>
                    <span class="mt-1 block text-xs leading-relaxed">{n.data.description}</span>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>
