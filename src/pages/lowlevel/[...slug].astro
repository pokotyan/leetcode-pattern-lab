---
import { render } from 'astro:content'
import LowLevelLayout from '../../layouts/LowLevelLayout.astro'
import { loadLowLevelNotes } from '../../lib/prereq'

export async function getStaticPaths() {
  const { notes } = await loadLowLevelNotes()
  const published = notes.filter((n) => n.data.status === 'published')
  return published.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: published[i - 1] && { id: published[i - 1]!.id, title: published[i - 1]!.data.title },
      next: published[i + 1] && { id: published[i + 1]!.id, title: published[i + 1]!.data.title },
    },
  }))
}

const { entry, prev, next } = Astro.props
const { Content, headings } = await render(entry)
---

<LowLevelLayout entry={entry} prev={prev} next={next} headings={headings}>
  <Content />
</LowLevelLayout>
